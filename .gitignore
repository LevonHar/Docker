# SSH keys. The private key must never be published.
# The public key is also written into Lab1/vm/user-data by make_seed.py.
Lab1/keys/
Lab1/vm/user-data

# Logs can capture the Windows username
*.log
Lab2/run-result.txt

# QEMU runtime and installer (binaries; several files exceed GitHub's 100 MB limit)
Lab1/qemu/
Lab1/tools/*.exe

# VM disks, cloud images, and logs
Lab1/vm/*.img
Lab1/vm/*.qcow2
Lab1/vm/*.iso
Lab1/vm/*.log

# Downloaded installers
Lab2/installer/*.exe
